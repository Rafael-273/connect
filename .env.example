PROJECT_NAME=connect
HOSTNAME=connect.localhost
PORT=8000
SITE_DOMAIN=connect.localhost:8000

#Database
DB_NAME=connect
DB_USER=postgres
DB_PASSWORD=123
DB_HOST=connect-database
#Local
DB_PORT=5432

#Debug
DEBUG=TRUE

# Email
EMAIL_HOST_USER=seu_email@gmail.com
EMAIL_HOST_PASSWORD=sua_senha_de_app

# OpenAI (IA e transcrição de arquivos)
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Fila e processamento de Mídia Externa
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1
EXTERNAL_MEDIA_MAX_UPLOAD_MB=10240
EXTERNAL_MEDIA_AUDIO_CHUNK_SECONDS=1200
EXTERNAL_MEDIA_TRANSLATION_BATCH_SIZE=40
EXTERNAL_MEDIA_FFMPEG_TIMEOUT=21600
EXTERNAL_MEDIA_FFMPEG_PRESET=veryfast
EXTERNAL_MEDIA_RENDER_PRESET=superfast
EXTERNAL_MEDIA_INTERMEDIATE_PRESET=superfast
EXTERNAL_MEDIA_INTERMEDIATE_CRF=22
EXTERNAL_MEDIA_ASSEMBLY_WORKERS=2
EXTERNAL_MEDIA_PROXY_WIDTH=854
EXTERNAL_MEDIA_PROXY_CRF=30
EXTERNAL_MEDIA_PROXY_PRESET=ultrafast
EXTERNAL_MEDIA_AUTO_REFRAME_INTERVAL_FRAMES=10
EXTERNAL_MEDIA_AUTO_REFRAME_MAX_ANALYSIS_WIDTH=640
EXTERNAL_MEDIA_DIARIZATION_ENABLED=True
EXTERNAL_MEDIA_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
EXTERNAL_MEDIA_DIARIZATION_DEVICE=auto
EXTERNAL_MEDIA_WORKSPACE_ROOT=/tmp/media-jobs
EXTERNAL_MEDIA_WORKSPACE_MIN_FREE_GB=2
EXTERNAL_MEDIA_WORKSPACE_SAFETY_FACTOR=1.15
EXTERNAL_MEDIA_WORKSPACE_MAX_AGE_HOURS=24
EXTERNAL_MEDIA_STREAMING_WORKSPACE_ESTIMATE_MB=512
EXTERNAL_MEDIA_REMOTE_MATERIALIZE_MAX_MB=256
EXTERNAL_MEDIA_S3_URL_EXPIRATION_SECONDS=86400
# Aceite os termos de Community-1 no Hugging Face e informe um token de leitura.
HUGGINGFACE_TOKEN=
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# #AWS
# USE_S3=TRUE
# AWS_ACCESS_KEY_ID=#
# AWS_SECRET_ACCESS_KEY=#
# AWS_STORAGE_BUCKET_NAME=#
